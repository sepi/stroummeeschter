#!/bin/sh
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
VENV="$BASE_DIR/venv"
SYSTEMD_DIR="$HOME/.config/systemd/user"
UNITS="stroummeeschter-import-slimmelezer stroummeeschter-import-envoy stroummeeschter-web"

# ---------------------------------------------------------------------------
# 1. Create venv
# ---------------------------------------------------------------------------
if [ ! -d "$VENV" ]; then
    python3 -m venv "$VENV"
fi

"$VENV/bin/pip" install --quiet --upgrade pip

# ---------------------------------------------------------------------------
# 2. Install dependencies from requirements.in (loose version bounds), not
#    the pinned requirements.txt - that lock file was resolved by pip-compile
#    on whatever machine last regenerated it (a modern x86_64 dev box), and
#    its exact pins for matplotlib/pandas/numpy may simply not exist as
#    prebuilt wheels for an older Pi/Debian/Python combination. Letting pip
#    resolve freely here is what "no separate build machine" (see README)
#    actually requires - requirements.txt is still what CI/dev installs use,
#    on a machine those pins are known to match.
#
#    Then install this package itself (--no-deps, so it can't drag in
#    different dependency versions than were just installed above) -
#    without this the console-script entry points
#    (stroummeeschter-import-slimmelezer etc.) wouldn't exist at all.
# ---------------------------------------------------------------------------
"$VENV/bin/pip" install --quiet -r "$BASE_DIR/requirements.in"
"$VENV/bin/pip" install --quiet --no-deps "$BASE_DIR"

# ---------------------------------------------------------------------------
# 3. Install systemd user units
# ---------------------------------------------------------------------------
mkdir -p "$SYSTEMD_DIR"

for unit in $UNITS; do
    sed "s|/home/pi/stroummeeschter|$BASE_DIR|g" \
        "$BASE_DIR/src/stroummeeschter/$unit.service" \
        > "$SYSTEMD_DIR/$unit.service"
done

systemctl --user daemon-reload

# ---------------------------------------------------------------------------
# 4. Enable and start all units
# ---------------------------------------------------------------------------
for unit in $UNITS; do
    systemctl --user enable --now "$unit.service"
done

echo ""
echo "Done."
for unit in $UNITS; do
    echo "  $unit: $(systemctl --user is-active "$unit.service")"
done
echo ""
echo "Before stroummeeschter-import-envoy is useful, put your Envoy access"
echo "token in $BASE_DIR/envoy_token (chmod 600), then:"
echo "  systemctl --user restart stroummeeschter-import-envoy"
